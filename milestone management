    html += '</div></div>';

    html += '<div class="ed-block">';
    html += '<h3>项目节点</h3>';
    html += '<div class="ed-grid">';
    html += fieldHTML('项目启动日期', 'date', fmtDate(state.projectStart), 'pStart');
    html += fieldHTML('目标截止时间', 'datetime-local', fmtDT(state.deadline), 'pDeadline');
    html += fieldHTML('项目结束日期', 'date', fmtDate(state.projectEnd), 'pEnd');
    html += '</div>';
    html += '<div class="hint" style="margin-top:9px">修改后甘特图会立即重新排布，时间轴自动扩展。</div>';
    html += '</div>';

    var total = state.tasks.length;
    html += '<div class="ed-block">';
    html += '<h3>工作事项<span class="ed-tip">（共 ' + total + ' 项，可修改内容、调整顺序、删除、插入链接）</span></h3>';
    html += '<div class="ed-grid">';

    if (total === 0) {
      html += '<div class="ed-task" style="grid-column:1/-1;text-align:center;color:#94a3b8;padding:24px">' +
              '暂无工作事项，点击下方按钮添加</div>';
    }

    state.tasks.forEach(function (t, i) {
      var isFirst = i === 0;
      var isLast = i === total - 1;
      var rawLink = t.link || '';
      var okLink = normalizeLink(rawLink);
      var stateCls = '';
      var stateText = '';
      if (rawLink.trim()) {
        if (okLink) { stateCls = 'ok'; stateText = '✓ 可跳转'; }
        else { stateCls = 'warn'; stateText = '! 无效链接'; }
      }

      html += '<div class="ed-task" data-card-id="' + esc(t.id) + '">';
      html += '<div class="ed-task-head">';
      html += '<span class="ed-task-idx">' + (i + 1) + '</span>';
      html += '<input class="ed-inp name" type="text" data-tid="' + esc(t.id) + '" data-k="name" ' +
              'value="' + esc(t.name) + '" placeholder="工作事项名称" maxlength="120">';
      html += '<div class="ed-task-actions">';
      html += '<button class="ic-btn" type="button" data-act="up" data-tid="' + esc(t.id) + '" ' +
              'title="上移"' + (isFirst ? ' disabled' : '') + '>↑</button>';
      html += '<button class="ic-btn" type="button" data-act="down" data-tid="' + esc(t.id) + '" ' +
              'title="下移"' + (isLast ? ' disabled' : '') + '>↓</button>';
      html += '<button class="ic-btn danger" type="button" data-act="del" data-tid="' + esc(t.id) + '" ' +
              'title="删除">×</button>';
      html += '</div></div>';

      html += '<div class="ed-sub-label">工作事项说明 <i>（做什么、怎么做）</i></div>';
      html += '<textarea class="ed-inp" data-tid="' + esc(t.id) + '" data-k="desc" rows="2" ' +
              'placeholder="补充该事项的具体工作内容">' + esc(t.desc) + '</textarea>';

      html += '<div class="ed-task-dates">';
      html += '<input type="date" data-tid="' + esc(t.id) + '" data-k="start" value="' + fmtDate(t.start) + '">';
      html += '<span>→</span>';
      html += '<input type="date" data-tid="' + esc(t.id) + '" data-k="end" value="' + fmtDate(t.end) + '">';
      html += '</div>';

      html += '<div class="ed-task-foot">';
      html += '<label>交付物</label>';
      html += '<input class="ed-inp" type="text" data-tid="' + esc(t.id) + '" data-k="deliverable" ' +
              'value="' + esc(t.deliverable) + '" placeholder="该事项的交付物 / 验收标准" maxlength="120">';
      html += '</div>';

      html += '<div class="ed-link-row">';
      html += '<label>🔗 链接</label>';
      html += '<input type="text" data-tid="' + esc(t.id) + '" data-k="link" ' +
              'value="' + esc(rawLink) + '" ' +
              'placeholder="https://... 填写后任务名变蓝色可点击" maxlength="500">';
      html += '<span class="ed-link-state ' + stateCls + '" data-state-for="' + esc(t.id) + '">' +
              esc(stateText) + '</span>';
      html += '<a class="ed-link-open' + (okLink ? '' : ' disabled') + '" ' +
              'href="' + (okLink ? esc(okLink) : '#') + '" ' +
              'target="_blank" rel="noopener noreferrer" ' +
              'data-open-for="' + esc(t.id) + '" title="在新标签页打开">↗</a>';
      html += '</div>';

      html += '</div>';
    });

    html += '</div>';

    html += '<div class="add-task-wrap">';
    html += '<button class="btn add" id="addTask" type="button">＋ 添加工作事项</button>';
    html += '<span class="hint">新事项默认接续在最后一项之后，可自行调整时间</span>';
    html += '</div></div>';

    html += '<div class="ed-block">';
    html += '<h3>整体平移</h3>';
    html += '<div class="shift-row">';
    html += '<span>全部日期</span>';
    html += '<input type="number" id="shiftDays" value="0" step="1" min="-365" max="365">';
    html += '<span>天</span>';
    html += '<button class="btn small" id="shiftApply" type="button">应用</button>';
    html += '<span class="hint">负数表示整体提前（例如 -5 表示所有节点提前 5 天）</span>';
    html += '</div></div>';

    ed.innerHTML = html;
  }

  /* ============================================================
     事件处理
  ============================================================ */
  function findTask(id) {
    var t = null;
    state.tasks.forEach(function (x) { if (x.id === id) t = x; });
    return t;
  }
  function findIndex(id) {
    var idx = -1;
    state.tasks.forEach(function (x, i) { if (x.id === id) idx = i; });
    return idx;
  }

  function updateLinkUI(tid) {
    var t = findTask(tid);
    if (!t) return;
    var rawLink = t.link || '';
    var okLink = normalizeLink(rawLink);
    var stateEl = document.querySelector('.ed-link-state[data-state-for="' + tid + '"]');
    if (stateEl) {
      if (!rawLink.trim()) {
        stateEl.className = 'ed-link-state';
        stateEl.textContent = '';
      } else if (okLink) {
        stateEl.className = 'ed-link-state ok';
        stateEl.textContent = '✓ 可跳转';
      } else {
        stateEl.className = 'ed-link-state warn';
        stateEl.textContent = '! 无效链接';
      }
    }
    var openEl = document.querySelector('.ed-link-open[data-open-for="' + tid + '"]');
    if (openEl) {
      if (okLink) {
        openEl.classList.remove('disabled');
        openEl.href = okLink;
      } else {
        openEl.classList.add('disabled');
        openEl.href = '#';
      }
    }
  }

  function onEditorInput(ev) {
    var el = ev.target;
    if (!el || !el.dataset) return;
    var k = el.dataset.k;

    if (k === 'title' && !el.dataset.tid) {
      state.title = el.value;
      renderTitle();
      saveState();
      flashSaved();
      return;
    }
    if (k === 'goal' && !el.dataset.tid) {
      state.goal = el.value;
      var goalEl = document.getElementById('goalText');
      if (goalEl) goalEl.textContent = el.value;
      saveState();
      flashSaved();
      return;
    }
    if (k !== 'name' && k !== 'desc' && k !== 'deliverable' && k !== 'link') return;

    var t = findTask(el.dataset.tid);
    if (!t) return;
    t[k] = el.value;
    if (k === 'link') updateLinkUI(t.id);
    saveState();
    renderGantt();
    flashSaved();
  }

  function onEditorChange(ev) {
    var el = ev.target;
    if (!el || !el.dataset || !el.dataset.k) return;
    var key = el.dataset.k;
    if (key === 'title' || key === 'goal' || key === 'name' ||
        key === 'desc' || key === 'deliverable' || key === 'link') return;

    if (el.dataset.tid) {
      var target = findTask(el.dataset.tid);
      if (!target) return;
      var d = parseDate(el.value);
      if (!isValidDate(d)) return;
      if (key === 'start') {
        target.start = d;
        if (target.end < target.start) target.end = new Date(d.getTime());
      } else {
        target.end = d;
        if (target.end < target.start) target.start = new Date(d.getTime());
      }
    } else {
      if (key === 'pStart') {
        var v1 = parseDate(el.value);
        if (!isValidDate(v1)) return;
        state.projectStart = v1;
        if (state.projectEnd < state.projectStart) state.projectEnd = new Date(v1.getTime());
      } else if (key === 'pEnd') {
        var v2 = parseDate(el.value);
        if (!isValidDate(v2)) return;
        state.projectEnd = v2;
        if (state.projectEnd < state.projectStart) state.projectStart = new Date(v2.getTime());
      } else if (key === 'pDeadline') {
        var v3 = parseDT(el.value);
        if (!isValidDate(v3)) return;
        state.deadline = v3;
      }
    }
    saveState();
    renderGantt();
    syncEditorValues();
    flashSaved();
  }

  function onEditorClick(ev) {
    var el = ev.target;
    if (!el || !el.dataset) return;
    if (el.id === 'shiftApply') { applyShift(); return; }
    if (el.id === 'addTask') { addTask(); return; }
    if (el.classList && el.classList.contains('ed-link-open')) {
      if (el.classList.contains('disabled')) ev.preventDefault();
      return;
    }
    var act = el.dataset.act;
    var tid = el.dataset.tid;
    if (act && tid) handleTaskAction(act, tid);
  }

  function handleTaskAction(act, id) {
    var idx = findIndex(id);
    if (idx < 0) return;
    var t = state.tasks[idx];

    if (act === 'up') {
      if (idx === 0) return;
      state.tasks.splice(idx, 1);
      state.tasks.splice(idx - 1, 0, t);
      flashSaved('已上移「' + (t.name || '未命名任务') + '」');
    } else if (act === 'down') {
      if (idx === state.tasks.length - 1) return;
      state.tasks.splice(idx, 1);
      state.tasks.splice(idx + 1, 0, t);
      flashSaved('已下移「' + (t.name || '未命名任务') + '」');
    } else if (act === 'del') {
      if (state.tasks.length <= 1) { flashSaved('至少保留一项工作事项'); return; }
      var label = t.name || '未命名任务';
      if (!window.confirm('确定删除「' + label + '」吗？')) return;
      state.tasks.splice(idx, 1);
      flashSaved('已删除「' + label + '」');
    }
    saveState();
    renderEditor();
    renderGantt();
  }

  function addTask() {
    var today = toDay(new Date());
    var s, e;
    if (state.tasks.length > 0) {
      var last = state.tasks[state.tasks.length - 1];
      s = addDays(last.end, 1);
    } else {
      s = new Date(Math.max(today.getTime(), toDay(state.projectStart).getTime()));
    }
    e = addDays(s, 6);
    var newTask = {
      id: newId(), name: '新工作事项', desc: '',
      deliverable: '', link: '', start: s, end: e
    };
    state.tasks.push(newTask);
    saveState();
    renderEditor();
    renderGantt();
    flashSaved('已添加新工作事项');

    setTimeout(function () {
      var card = document.querySelector('.ed-task[data-card-id="' + newTask.id + '"]');
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.classList.add('flash');
        setTimeout(function () { card.classList.remove('flash'); }, 1600);
        var nameInput = card.querySelector('.ed-inp.name');
        if (nameInput) { nameInput.focus(); nameInput.select(); }
      }
    }, 60);
  }

  function syncEditorValues() {
    var inputs = document.querySelectorAll('#editor [data-k]');
    Array.prototype.forEach.call(inputs, function (inp) {
      var key = inp.dataset.k;
      if (inp.dataset.tid) {
        var t = findTask(inp.dataset.tid);
        if (!t) return;
        if (key === 'start') inp.value = fmtDate(t.start);
        else if (key === 'end') inp.value = fmtDate(t.end);
        else if (key === 'name') inp.value = t.name;
        else if (key === 'desc') inp.value = t.desc;
        else if (key === 'deliverable') inp.value = t.deliverable;
        else if (key === 'link') { inp.value = t.link || ''; updateLinkUI(t.id); }
      } else {
        if (key === 'title') inp.value = state.title || '';
        else if (key === 'goal') inp.value = state.goal || '';
        else if (key === 'pStart') inp.value = fmtDate(state.projectStart);
        else if (key === 'pEnd') inp.value = fmtDate(state.projectEnd);
        else if (key === 'pDeadline') inp.value = fmtDT(state.deadline);
      }
    });
  }

  function applyShift() {
    var el = document.getElementById('shiftDays');
    if (!el) return;
    var n = parseInt(el.value, 10);
    if (isNaN(n) || n === 0) { flashSaved('请输入非 0 的天数'); return; }
    state.projectStart = addDays(state.projectStart, n);
    state.projectEnd = addDays(state.projectEnd, n);
    state.deadline = addDays(state.deadline, n);
    state.tasks.forEach(function (t) {
      t.start = addDays(t.start, n);
      t.end = addDays(t.end, n);
    });
    el.value = 0;
    saveState();
    renderGantt();
    syncEditorValues();
    flashSaved('已整体' + (n > 0 ? '推迟' : '提前') + Math.abs(n) + '天');
  }

  /* ============================================================
     提示
  ============================================================ */
  var hintTimer = null;
  function flashSaved(msg) {
    var el = document.getElementById('saveHint');
    if (!el) return;
    el.textContent = msg || '✓ 已保存到本机浏览器';
    el.style.color = '#10b981';
    if (hintTimer) clearTimeout(hintTimer);
    hintTimer = setTimeout(function () {
      el.textContent = '修改会自动保存在本机浏览器中';
      el.style.color = '#94a3b8';
    }, 2200);
  }

  /* ============================================================
     分享弹窗
  ============================================================ */
  var shareModal = document.getElementById('shareModal');
  var shareUrlEl = document.getElementById('shareUrl');
  var shareLenEl = document.getElementById('shareLen');
  var shareCopyHint = document.getElementById('shareCopyHint');

  /* 估算旧格式长度，用于对比 */
  function estimateOldLength() {
    try {
      var json = packState();
      var bytes = new TextEncoder().encode(json);
      var base = window.location.href.split('#')[0].split('?')[0];
      return base.length + 3 + bytesToBase64Url(bytes).length;
    } catch (e) {
      return 0;
    }
  }

  function openShareModal() {
    var url = generateShareUrl();
    shareUrlEl.value = url;

    var len = url.length;
    var oldLen = estimateOldLength();

    shareLenEl.className = 'saved';
    shareLenEl.textContent = '已压缩：' + len + ' 字符';

    if (oldLen && oldLen > len) {
      var saved = oldLen - len;
      var pct = Math.round(saved / oldLen * 100);
      shareLenEl.textContent += '（旧格式约 ' + oldLen + ' 字符，缩短约 ' + pct + '%）';
    }

    shareCopyHint.textContent = '';
    shareCopyHint.className = '';
    shareModal.classList.add('open');

    setTimeout(function () {
      try { shareUrlEl.focus(); shareUrlEl.select(); } catch (e) {}
    }, 80);
  }

  function closeShareModal() { shareModal.classList.remove('open'); }

  function copyShareUrl() {
    var text = shareUrlEl.value;
    if (!text) return;
    function done() {
      shareCopyHint.textContent = '✓ 已复制到剪贴板';
      shareCopyHint.className = 'ok';
      setTimeout(function () {
        shareCopyHint.textContent = '';
        shareCopyHint.className = '';
      }, 2200);
    }
    function fail() {
      try {
        shareUrlEl.focus();
        shareUrlEl.select();
        document.execCommand('copy');
        done();
      } catch (e) {
        shareCopyHint.textContent = '请手动选中复制';
        shareCopyHint.className = 'warn';
      }
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done, fail);
    } else fail();
  }

  document.getElementById('shareBtn').addEventListener('click', openShareModal);
  document.getElementById('shareClose').addEventListener('click', closeShareModal);
  document.getElementById('shareDone').addEventListener('click', closeShareModal);
  document.getElementById('shareCopy').addEventListener('click', copyShareUrl);

  shareModal.addEventListener('click', function (ev) {
    if (ev.target === shareModal) closeShareModal();
  });
  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape' && shareModal.classList.contains('open')) closeShareModal();
  });
  document.getElementById('sharedBannerClose').addEventListener('click', function () {
    document.getElementById('sharedBanner').style.display = 'none';
  });

  /* ============================================================
     初始化
  ============================================================ */
  var editBtn = document.getElementById('editBtn');
  var editorEl = document.getElementById('editor');

  editBtn.addEventListener('click', function () {
    var open = editorEl.classList.toggle('open');
    editBtn.classList.toggle('on', open);
    editBtn.textContent = open ? '✓ 收起编辑面板' : '✏️ 编辑计划';
  });

  document.getElementById('resetBtn').addEventListener('click', function () {
    if (!window.confirm('确定要恢复为原始计划的时间与内容吗？当前修改将丢失。')) return;
    state = defaultState();
    try {
      localStorage.removeItem(STORE_KEY);
      LEGACY_KEYS.forEach(function (k) { localStorage.removeItem(k); });
    } catch (e) {}
    renderEditor();
    renderGantt();
    flashSaved('已恢复默认时间与内容');
  });

  editorEl.addEventListener('input', onEditorInput);
  editorEl.addEventListener('change', onEditorChange);
  editorEl.addEventListener('click', onEditorClick);

  var lastSig = '';
  function signature() {
    var today0 = toDay(new Date());
    var parts = state.tasks.map(function (t) {
      return getStatus(t.start, t.end, today0);
    });
    return parts.join('|') + '#' + today0.getTime() + '#' + state.tasks.length;
  }
  function tick() {
    var sig = signature();
    if (sig !== lastSig) { lastSig = sig; renderGantt(); }
  }

  /* 先尝试加载分享链接 */
  var hadShare = false;
  var hadShareError = false;
  try {
    var shareFound = extractShareParam();
    if (shareFound) {
      hadShare = tryLoadShared();
      if (!hadShare) hadShareError = true;
    }
  } catch (e) {
    console.warn('[分享] 加载失败：', e);
    hadShareError = true;
  }

  renderEditor();
  renderGantt();

  if (hadShare) {
    saveState();
    var banner = document.getElementById('sharedBanner');
    banner.style.display = 'flex';
    document.getElementById('sharedBannerText').innerHTML =
      '🔗 <b>已加载分享的甘特图</b>，内容已保存到你的浏览器。你可以继续编辑，或点击「生成分享链接」再次分享给别人。';
  } else if (hadShareError) {
    var banner2 = document.getElementById('sharedBanner');
    banner2.style.display = 'flex';
    banner2.classList.add('error');
    document.getElementById('sharedBannerText').innerHTML =
      '⚠️ <b>分享链接解析失败</b>，可能链接被截断或修改了。当前显示的是默认内容，你可以手动重新编辑。';
  }

  lastSig = signature();
  setInterval(tick, 60000);
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) tick();
  });
})();
</script>
</body>
</html>
