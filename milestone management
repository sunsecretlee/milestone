    html += '<div class="ed-block">';
    html += '<h3>总目标<span class="ed-tip">（会显示在页面顶部）</span></h3>';
    html += '<div class="goal-editor">';
    html += '<textarea data-k="goal" placeholder="填写总目标，例如：X月X日前完成……">' +
