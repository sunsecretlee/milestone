  function defaultState() {
    var Y = new Date().getFullYear();
    return {
      title: DEFAULT_TITLE,
      goal: DEFAULT_GOAL,
      projectStart: new Date(Y, 8, 28),
      projectEnd: new Date(Y, 10, 18),
      deadline: new Date(Y, 9, 30, 17, 0, 0, 0),
      tasks: defaultTasks()
    };
  }

  /* ============================================================
     打包 / 解包
  ============================================================ */
  function packState() {
    return JSON.stringify({
      t: state.title,
      g: state.goal,
      s: fmtDate(state.projectStart),
      e: fmtDate(state.projectEnd),
      d: fmtDT(state.deadline),
      k: state.tasks.map(function (t) {
        return [
          t.name,
          t.desc,
          t.deliverable,
          fmtDate(t.start),
          fmtDate(t.end),
          t.link || ''
        ];
      })
    });
  }

  function unpackState(o) {
    if (!o || typeof o !== 'object') return null;
    var Y = new Date().getFullYear();
    var title = (typeof o.t === 'string') ? o.t : DEFAULT_TITLE;
    var goal  = (typeof o.g === 'string') ? o.g : DEFAULT_GOAL;
    var ps = parseDate(o.s);
    var pe = parseDate(o.e);
    var dl = parseDT(o.d);
    if (!isValidDate(ps)) ps = new Date(Y, 8, 28);
    if (!isValidDate(pe)) pe = new Date(Y, 10, 18);
    if (!isValidDate(dl)) dl = new Date(Y, 9, 30, 17, 0, 0, 0);
    var tasks = [];
    if (Array.isArray(o.k)) {
      o.k.forEach(function (arr) {
        if (!Array.isArray(arr) || arr.length < 5) return;
        var s = parseDate(arr[3]);
        var e = parseDate(arr[4]);
        if (!isValidDate(s)) s = toDay(new Date());
        if (!isValidDate(e)) e = new Date(s.getTime());
        if (e < s) e = new Date(s.getTime());
        tasks.push({
          id: newId(),
          name: (typeof arr[0] === 'string') ? arr[0] : '',
          desc: (typeof arr[1] === 'string') ? arr[1] : '',
          deliverable: (typeof arr[2] === 'string') ? arr[2] : '',
          link: (typeof arr[5] === 'string') ? arr[5] : '',
          start: s, end: e
        });
      });
    }
    if (tasks.length === 0) tasks = defaultTasks();
    return {
      title: title, goal: goal,
      projectStart: ps, projectEnd: pe, deadline: dl,
      tasks: tasks
    };
  }

  /* ============================================================
     本地存储
  ============================================================ */
  var state = loadState() || defaultState();

  function serialize() {
    return JSON.stringify({
      v: 9,
      title: state.title,
      goal: state.goal,
      projectStart: fmtDate(state.projectStart),
      projectEnd: fmtDate(state.projectEnd),
      deadline: fmtDT(state.deadline),
      tasks: state.tasks.map(function (t) {
        return {
          id: t.id, name: t.name, desc: t.desc,
          deliverable: t.deliverable, link: t.link || '',
          start: fmtDate(t.start), end: fmtDate(t.end)
        };
      })
    });
  }

  function saveState() {
    try {
      localStorage.setItem(STORE_KEY, serialize());
      LEGACY_KEYS.forEach(function (k) { localStorage.removeItem(k); });
    } catch (e) {}
  }

  function loadState() {
    var raw = null;
    try {
      raw = localStorage.getItem(STORE_KEY);
      if (!raw) {
        for (var i = 0; i < LEGACY_KEYS.length && !raw; i++) {
          raw = localStorage.getItem(LEGACY_KEYS[i]);
        }
      }
    } catch (e) { return null; }
    if (!raw) return null;
    try {
      var o = JSON.parse(raw);
      if (!o || typeof o !== 'object') return null;
      var defaults = defaultTasks();
      var byId = {};
      defaults.forEach(function (t) { byId[t.id] = t; });
      var tasks;
      if (Array.isArray(o.tasks) && o.tasks.length > 0) {
        tasks = o.tasks.map(function (t, i) {
          if (!t || typeof t !== 'object') return null;
          var d = byId[t.id] || {};
          var s = parseDate(t.start);
          var e = parseDate(t.end);
          if (!isValidDate(s)) s = d.start ? new Date(d.start.getTime()) : toDay(new Date());
          if (!isValidDate(e)) e = d.end ? new Date(d.end.getTime()) : new Date(s.getTime());
          return {
            id: t.id || ('t_' + i + '_' + Date.now().toString(36)),
            name: (typeof t.name === 'string') ? t.name : (d.name || ''),
            desc: (typeof t.desc === 'string') ? t.desc : (d.desc || ''),
            deliverable: (typeof t.deliverable === 'string') ? t.deliverable : (d.deliverable || ''),
            link: (typeof t.link === 'string') ? t.link : '',
            start: s, end: e
          };
        }).filter(Boolean);
        if (tasks.length === 0) tasks = defaults;
      } else tasks = defaults;
      var ps = parseDate(o.projectStart);
      var pe = parseDate(o.projectEnd);
      var dl = parseDT(o.deadline);
      var Y = new Date().getFullYear();
      if (!isValidDate(ps)) ps = new Date(Y, 8, 28);
      if (!isValidDate(pe)) pe = new Date(Y, 10, 18);
      if (!isValidDate(dl)) dl = new Date(Y, 9, 30, 17, 0, 0, 0);
      var title = (typeof o.title === 'string') ? o.title : DEFAULT_TITLE;
      var goal = (typeof o.goal === 'string') ? o.goal : DEFAULT_GOAL;
      return { title: title, goal: goal, projectStart: ps, projectEnd: pe, deadline: dl, tasks: tasks };
    } catch (e) { return null; }
  }

  function normalize() {
    state.tasks.forEach(function (t) {
      if (typeof t.link !== 'string') t.link = '';
      if (t.end < t.start) t.end = new Date(t.start.getTime());
    });
    if (state.projectEnd < state.projectStart) {
      state.projectEnd = new Date(state.projectStart.getTime());
    }
    if (typeof state.title !== 'string') state.title = DEFAULT_TITLE;
    if (typeof state.goal !== 'string') state.goal = DEFAULT_GOAL;
  }

  /* ============================================================
     分享链接：生成
     使用 ?z=<Base64URL>，只含 A-Za-z0-9-_，绝对不会被 URL 转义打断
  ============================================================ */
  function generateShareUrl() {
    var json = packState();
    var base = window.location.href.split('#')[0].split('?')[0];
    var compressed = compressToBase64Url(json);
    if (compressed) {
      return base + '?z=' + compressed;
    }
    /* 兜底：原始 Base64URL */
    try {
      var bytes = new TextEncoder().encode(json);
      return base + '?p=' + bytesToBase64Url(bytes);
    } catch (e) {
      return base;
    }
  }

  /* ============================================================
     分享链接：读取
     同时兼容：
       ?z=<Base64URL(LZString字节)>   新格式
       ?p=<Base64URL(JSON-UTF8)>      旧格式（v8 之前）
       #z=... / #p=...                老 hash 格式
  ============================================================ */
  function extractShareParam() {
    var raw = null;
    /* 1) query string 优先 */
    try {
      var qs = window.location.search || '';
      var mz = qs.match(/[?&]z=([^&#]*)/);
      if (mz) return { type: 'z', data: decodeSafe(mz[1]) };
      var mp = qs.match(/[?&]p=([^&#]*)/);
      if (mp) return { type: 'p', data: decodeSafe(mp[1]) };
    } catch (e) {}

    /* 2) 老 hash 格式 */
    try {
      var hs = window.location.hash || '';
      var mz2 = hs.match(/[#&]z=([^&]*)/);
      if (mz2) return { type: 'z', data: decodeSafe(mz2[1]) };
      var mp2 = hs.match(/[#&]p=([^&]*)/);
      if (mp2) return { type: 'p', data: decodeSafe(mp2[1]) };
    } catch (e) {}

    return null;
  }

  function decodeSafe(s) {
    try { return decodeURIComponent(s); } catch (e) { return String(s); }
  }

  function tryLoadShared() {
    var found = extractShareParam();
    if (!found || !found.data) return false;

    var newState = null;

    /* 新格式：LZString 压缩 + Base64URL */
    if (found.type === 'z') {
      var json = decompressFromBase64Url(found.data);
      if (json) {
        try { newState = unpackState(JSON.parse(json)); } catch (e) {
          console.warn('[分享] z 格式 JSON 解析失败：', e);
        }
      }
    }

    /* 旧格式：Base64URL(JSON-UTF8) */
    if (!newState && found.type === 'p') {
      try {
        var bytes = base64UrlToBytes(found.data);
        var json2 = new TextDecoder().decode(bytes);
        newState = unpackState(JSON.parse(json2));
      } catch (e) {
        console.warn('[分享] p 格式解析失败：', e);
      }
    }

    /* 交叉兜底：z 失败时尝试 p 方式解码（可能是数据混用） */
    if (!newState && found.type === 'z') {
      try {
        var bytes2 = base64UrlToBytes(found.data);
        var json3 = new TextDecoder().decode(bytes2);
        if (json3 && json3.charAt(0) === '{') {
          newState = unpackState(JSON.parse(json3));
        }
      } catch (e) {}
    }

    if (!newState) return false;

    state = newState;
    normalize();

    /* 清理 URL */
    try {
      var clean = window.location.href.split('#')[0].split('?')[0];
      window.history.replaceState(null, '', clean);
    } catch (e) {}

    return true;
  }

  /* ============================================================
     时间轴 & 状态
  ============================================================ */
  var TL_START, TL_END, TOTAL_DAYS;

  function buildTimeline() {
    var pts = [
      toDay(state.projectStart).getTime(),
      toDay(state.projectEnd).getTime()
    ];
    state.tasks.forEach(function (t) {
      pts.push(toDay(t.start).getTime());
      pts.push(toDay(t.end).getTime());
    });
    var minT = Math.min.apply(null, pts);
    var maxT = Math.max.apply(null, pts);
    TL_START = toDay(new Date(minT - 2 * MS_DAY));
    TL_END   = toDay(new Date(maxT + 2 * MS_DAY));
    TOTAL_DAYS = dayDiff(TL_START, TL_END) + 1;
    if (TOTAL_DAYS < 1) TOTAL_DAYS = 1;
  }

  var STATUS_TEXT = { done: '已完成', active: '进行中', pending: '未开始' };

  function getStatus(s, e, today0) {
    if (today0.getTime() > e.getTime()) return 'done';
    if (today0.getTime() < s.getTime()) return 'pending';
    return 'active';
  }

  function renderTitle() {
    var el = document.getElementById('pageTitle');
    var txt = (state.title || '').trim();
    el.textContent = txt || '（未命名计划）';
    el.classList.toggle('empty', !txt);
    document.title = txt || '进度甘特图';
  }

  /* ============================================================
     渲染甘特图
  ============================================================ */
  function renderGantt() {
    normalize();
    buildTimeline();
    renderTitle();

    var gantt = document.getElementById('gantt');
    gantt.innerHTML = '';
    gantt.style.setProperty('--day-pct', (100 / TOTAL_DAYS) + '%');
    if (TOTAL_DAYS > 110) gantt.classList.add('no-grid');
    else gantt.classList.remove('no-grid');

    var now = new Date();
    var today0 = toDay(now);

    var head = document.createElement('div');
    head.className = 'gantt-head';
    var headLabel = document.createElement('div');
    headLabel.className = 'label-col';
    headLabel.textContent = '里程碑 / 任务';
    var headTime = document.createElement('div');
    headTime.className = 'time-col';
    head.appendChild(headLabel);
    head.appendChild(headTime);
    gantt.appendChild(head);

    var cursor = new Date(TL_START.getFullYear(), TL_START.getMonth(), 1);
    var firstSeg = true;
    var guard = 0;
    while (cursor.getTime() <= TL_END.getTime() && guard++ < 400) {
      var next = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1);
      var segStart = new Date(Math.max(cursor.getTime(), TL_START.getTime()));
      var segEnd = new Date(Math.min(next.getTime() - MS_DAY, TL_END.getTime()));
      var n = dayDiff(segStart, segEnd) + 1;
      if (n > 0) {
        var sIdx = dayDiff(TL_START, segStart);
        var el = document.createElement('div');
        el.className = 'month-seg';
        el.style.left = (sIdx / TOTAL_DAYS * 100) + '%';
        el.style.width = (n / TOTAL_DAYS * 100) + '%';
        el.textContent = (firstSeg || cursor.getMonth() === 0)
          ? (cursor.getFullYear() + '年' + (cursor.getMonth() + 1) + '月')
          : ((cursor.getMonth() + 1) + '月');
        headTime.appendChild(el);
        firstSeg = false;
      }
      cursor = next;
    }

    var step = TOTAL_DAYS <= 21 ? 1
             : TOTAL_DAYS <= 45 ? 3
             : TOTAL_DAYS <= 90 ? 7
             : TOTAL_DAYS <= 200 ? 14 : 30;
    for (var d = 0; d < TOTAL_DAYS; d += step) {
      var dt = addDays(TL_START, d);
      var tick = document.createElement('div');
      tick.className = 'tick' + (d === 0 ? ' no-line' : '');
      tick.style.left = (d / TOTAL_DAYS * 100) + '%';
      var sp = document.createElement('span');
      sp.textContent = (dt.getMonth() + 1) + '/' + dt.getDate();
      tick.appendChild(sp);
      headTime.appendChild(tick);
    }

    var body = document.createElement('div');
    body.className = 'gantt-body';

    var todayIdx = dayDiff(TL_START, today0);
    if (todayIdx >= 0 && todayIdx < TOTAL_DAYS) {
      var frac = (todayIdx + 0.5) / TOTAL_DAYS;
      var line = document.createElement('div');
      line.className = 'today-line';
      line.style.left = 'calc(var(--label-w) + (100% - var(--label-w)) * ' + frac + ')';
      body.appendChild(line);
    }

    var counts = { done: 0, active: 0, pending: 0 };

    if (state.tasks.length === 0) {
      var emptyRow = document.createElement('div');
      emptyRow.className = 'gantt-row';
      emptyRow.style.height = '80px';
      var el1 = document.createElement('div');
      el1.className = 'label-col';
      el1.style.color = '#94a3b8';
      el1.style.fontSize = '13px';
      el1.textContent = '暂无工作事项，请点击「编辑计划」添加';
      var el2 = document.createElement('div');
      el2.className = 'time-col';
      emptyRow.appendChild(el1);
      emptyRow.appendChild(el2);
      body.appendChild(emptyRow);
    }

    state.tasks.forEach(function (t) {
      var sIdx = dayDiff(TL_START, t.start);
      var eIdx = dayDiff(TL_START, t.end);
      if (sIdx < 0) sIdx = 0;
      if (eIdx > TOTAL_DAYS - 1) eIdx = TOTAL_DAYS - 1;
      if (eIdx < sIdx) eIdx = sIdx;

      var status = getStatus(t.start, t.end, today0);
      counts[status]++;

      var leftPct = sIdx / TOTAL_DAYS * 100;
      var widthPct = (eIdx - sIdx + 1) / TOTAL_DAYS * 100;

      var prog = 0;
      if (status === 'done') prog = 1;
      else if (status === 'active') {
        var sT = t.start.getTime();
        var eT = t.end.getTime() + MS_DAY - 1;
        prog = Math.min(1, Math.max(0, (now.getTime() - sT) / (eT - sT)));
      }

      var sameDay = dayDiff(t.start, t.end) === 0;
      var dateText = sameDay
        ? (t.start.getMonth() + 1) + '月' + t.start.getDate() + '日'
        : (t.start.getMonth() + 1) + '月' + t.start.getDate() + '日 - ' +
          (t.end.getMonth() + 1) + '月' + t.end.getDate() + '日';

      var hasName = !!(t.name && t.name.trim());
      var hasDeliver = !!(t.deliverable && t.deliverable.trim());
      var link = normalizeLink(t.link);

      var row = document.createElement('div');
      row.className = 'gantt-row';

      var label = document.createElement('div');
      label.className = 'label-col';

      var top = document.createElement('div');
      top.className = 'task-top';

      var nameEl;
      var nameText = hasName ? t.name : '（未命名任务）';

      if (link) {
        nameEl = document.createElement('a');
        nameEl.className = 'task-name link' + (hasName ? '' : ' empty');
        nameEl.href = link;
        nameEl.target = '_blank';
        nameEl.rel = 'noopener noreferrer';
        nameEl.textContent = nameText;
        nameEl.title = nameText + '\n点击打开：' + link;
        nameEl.addEventListener('click', function (ev) { ev.stopPropagation(); });
      } else {
        nameEl = document.createElement('span');
        nameEl.className = 'task-name' + (hasName ? '' : ' empty');
        nameEl.textContent = nameText;
        nameEl.title = nameText;
      }

      var badge = document.createElement('span');
      badge.className = 'badge ' + status;
      badge.textContent = STATUS_TEXT[status];

      top.appendChild(nameEl);
      top.appendChild(badge);

      var sub = document.createElement('div');
      sub.className = 'task-sub';
      sub.textContent = dateText + (hasDeliver ? ' · ' + t.deliverable : '');
      sub.title = nameText +
                  (t.desc ? '\n说明：' + t.desc : '') +
                  '\n时间：' + dateText +
                  '\n交付物：' + (hasDeliver ? t.deliverable : '（未填写）') +
                  (link ? '\n链接：' + link : '');

      label.appendChild(top);
      label.appendChild(sub);

      var timeCell = document.createElement('div');
      timeCell.className = 'time-col';

      var bar = document.createElement('div');
      bar.className = 'bar ' + status;
      bar.style.left = leftPct + '%';
      bar.style.width = widthPct + '%';
      bar.title = nameText + '\n' + dateText +
                  '\n状态：' + STATUS_TEXT[status] +
                  (status === 'active' ? '（' + Math.round(prog * 100) + '%）' : '') +
                  (t.desc ? '\n说明：' + t.desc : '') +
                  '\n交付物：' + (hasDeliver ? t.deliverable : '（未填写）') +
                  (link ? '\n链接：' + link : '');

      if (status === 'active') {
        var fill = document.createElement('div');
        fill.className = 'bar-fill';
        fill.style.width = (prog * 100).toFixed(1) + '%';
        bar.appendChild(fill);
      } else if (status === 'done' && widthPct >= 2.5) {
        var chk = document.createElement('div');
        chk.className = 'bar-check';
        chk.textContent = '✓';
        bar.appendChild(chk);
      }

      timeCell.appendChild(bar);
      row.appendChild(label);
      row.appendChild(timeCell);
      body.appendChild(row);
    });

    gantt.appendChild(body);

    document.getElementById('goalText').textContent = state.goal || '';
    document.getElementById('todayInfo').textContent =
      '当前日期：' + now.getFullYear() + '年' + (now.getMonth() + 1) + '月' +
      now.getDate() + '日 ' + pad(now.getHours()) + ':' + pad(now.getMinutes());

    var dlEl = document.getElementById('deadlineInfo');
    var diffDays = Math.ceil((state.deadline.getTime() - now.getTime()) / MS_DAY);
    if (diffDays > 0) {
      dlEl.textContent = '距目标截止还有 ' + diffDays + ' 天';
      dlEl.style.color = diffDays <= 7 ? '#dc2626' : '#475569';
    } else if (diffDays === 0) {
      dlEl.textContent = '今天就是目标截止日';
      dlEl.style.color = '#dc2626';
    } else {
      dlEl.textContent = '目标截止日已过 ' + Math.abs(diffDays) + ' 天';
      dlEl.style.color = '#dc2626';
    }

    document.getElementById('rangeInfo').textContent =
      '时间轴：' + (TL_START.getMonth() + 1) + '月' + TL_START.getDate() + '日 - ' +
      (TL_END.getMonth() + 1) + '月' + TL_END.getDate() + '日（' + TOTAL_DAYS + '天）';

    var linkCount = 0;
    state.tasks.forEach(function (t) { if (normalizeLink(t.link)) linkCount++; });

    document.getElementById('statInfo').textContent =
      '共 ' + state.tasks.length + ' 项 ｜ 已完成 ' + counts.done +
      ' · 进行中 ' + counts.active + ' · 未开始 ' + counts.pending +
      (linkCount ? ' · 带链接 ' + linkCount : '');
  }

  /* ============================================================
     渲染编辑面板
  ============================================================ */
  function fieldHTML(label, type, value, key, extra) {
    return '<div class="ed-field">' +
      '<label>' + esc(label) + '</label>' +
      '<input type="' + type + '" data-k="' + key + '" value="' + esc(value) + '"' + (extra || '') + '>' +
      '</div>';
  }

  function renderEditor() {
    var ed = document.getElementById('editor');
    var html = '';

    html += '<div class="ed-block">';
    html += '<h3>页面标题<span class="ed-tip">（会显示在页面顶部与浏览器标签页）</span></h3>';
    html += '<div class="title-editor">';
    html += '<input type="text" data-k="title" value="' + esc(state.title) +
            '" placeholder="填写计划标题" maxlength="120">';
