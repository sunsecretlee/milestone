<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>全链条梳理结果报送 · 可编辑甘特图</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 24px 20px 40px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
                 "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    background: #eef2f7;
    color: #0f172a;
    -webkit-font-smoothing: antialiased;
  }
  .page { max-width: 1480px; margin: 0 auto; }
  .hero {
    background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 22px 26px;
    box-shadow: 0 6px 22px -12px rgba(15, 23, 42, .18);
    margin-bottom: 16px;
  }
  .hero h1 {
    margin: 0 0 12px; font-size: 21px; letter-spacing: .3px;
    line-height: 1.45; word-break: break-word;
  }
  .hero h1.empty { color: #cbd5e1; font-weight: 500; font-style: italic; }
  .goal {
    display: flex; align-items: flex-start; gap: 10px;
    background: linear-gradient(90deg, #fff7ed 0%, #fffbeb 100%);
    border: 1px solid #fed7aa; border-radius: 10px;
    padding: 11px 15px; font-size: 13.5px; line-height: 1.6; color: #7c2d12;
  }
  .goal b { color: #9a3412; }
  .goal-text { white-space: pre-wrap; word-break: break-word; min-width: 0; }
  .meta-row {
    display: flex; flex-wrap: wrap; gap: 10px 22px;
    margin-top: 14px; font-size: 12.5px; color: #475569;
  }
  .meta-item { display: flex; align-items: center; gap: 6px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #3b82f6; }
  .dot.red { background: #ef4444; }
  .dot.green { background: #10b981; }
  .dot.slate { background: #94a3b8; }
  .toolbar {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
    margin-top: 16px; padding-top: 14px; border-top: 1px dashed #e2e8f0;
  }
  .btn {
    appearance: none; border: 1px solid #cbd5e1; background: #fff; color: #334155;
    font-size: 13px; font-family: inherit; padding: 7px 15px; border-radius: 9px;
    cursor: pointer; transition: all .16s ease;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .btn:hover { background: #f1f5f9; border-color: #94a3b8; }
  .btn.primary {
    background: linear-gradient(180deg, #3b82f6, #2563eb);
    border-color: #2563eb; color: #fff;
    box-shadow: 0 3px 10px -4px rgba(37, 99, 235, .8);
  }
  .btn.primary:hover { filter: brightness(1.07); }
  .btn.primary.on { background: linear-gradient(180deg, #0f172a, #1e293b); border-color: #0f172a; }
  .btn.small { padding: 5px 12px; font-size: 12.5px; }
  .btn.add {
    border-style: dashed; border-color: #93c5fd; color: #2563eb;
    background: #f8fbff; font-weight: 600;
  }
  .btn.add:hover { background: #eff6ff; border-style: solid; border-color: #3b82f6; }
  .btn.share {
    background: linear-gradient(180deg, #8b5cf6, #7c3aed);
    border-color: #7c3aed; color: #fff;
    box-shadow: 0 3px 10px -4px rgba(124, 58, 237, .8);
  }
  .btn.share:hover { filter: brightness(1.08); }
  .hint { font-size: 12px; color: #94a3b8; }
  .shared-banner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; flex-wrap: wrap;
    background: linear-gradient(90deg, #eff6ff 0%, #f0f9ff 100%);
    border: 1px solid #bfdbfe; border-radius: 12px;
    padding: 11px 16px; margin-bottom: 16px; font-size: 13px; color: #1e40af;
    animation: slideDown .22s ease;
  }
  .shared-banner b { color: #1d4ed8; }
  .shared-banner.error {
    background: linear-gradient(90deg, #fef2f2 0%, #fff1f2 100%);
    border-color: #fecaca; color: #991b1b;
  }
  .shared-banner.error b { color: #b91c1c; }
  .editor {
    display: none; background: #fff; border: 1px solid #e2e8f0;
    border-radius: 16px; padding: 20px 24px 22px; margin-bottom: 16px;
    box-shadow: 0 6px 22px -12px rgba(15, 23, 42, .18);
    animation: slideDown .22s ease;
  }
  .editor.open { display: block; }
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .ed-block + .ed-block {
    margin-top: 20px; padding-top: 18px; border-top: 1px dashed #e2e8f0;
  }
  .ed-block h3 {
    margin: 0 0 12px; font-size: 13px; font-weight: 700; color: #334155;
    letter-spacing: .4px; display: flex; align-items: center; gap: 7px;
  }
  .ed-block h3::before {
    content: ''; width: 3px; height: 13px; border-radius: 2px; background: #3b82f6;
  }
  .ed-tip { font-size: 11.5px; font-weight: 400; color: #94a3b8; margin-left: 4px; }
  .ed-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(346px, 1fr));
    gap: 14px 18px;
  }
  .ed-field { display: flex; flex-direction: column; gap: 5px; }
  .ed-field label {
    font-size: 11.5px; color: #64748b; font-weight: 600; letter-spacing: .2px;
  }
  .ed-field input {
    font-family: inherit; font-size: 13px; color: #1e293b;
    padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px;
    background: #f8fafc; transition: all .15s ease; width: 100%;
  }
  .ed-field input:focus {
    outline: none; border-color: #3b82f6; background: #fff;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, .14);
  }
  .title-editor input {
    width: 100%; font-family: inherit; font-size: 15px; font-weight: 700;
    letter-spacing: .3px; color: #0f172a; padding: 10px 13px;
    border: 1px solid #cbd5e1; border-radius: 10px; background: #f8fafc;
    transition: border-color .15s, box-shadow .15s, background .15s;
  }
  .title-editor input:focus {
    outline: none; border-color: #3b82f6; background: #fff;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, .16);
  }
  .title-editor input::placeholder { color: #cbd5e1; font-weight: 500; }
  .goal-editor {
    background: linear-gradient(180deg, #fffbeb 0%, #fffdf5 100%);
    border: 1px solid #fde68a; border-radius: 11px; padding: 12px 14px;
  }
  .goal-editor textarea {
    width: 100%; font-family: inherit; font-size: 13.5px; line-height: 1.65;
    color: #7c2d12; padding: 9px 12px; border: 1px solid #fcd34d;
    border-radius: 9px; background: #fff; resize: vertical;
    min-height: 62px; transition: border-color .15s, box-shadow .15s;
  }
  .goal-editor textarea:focus {
    outline: none; border-color: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, .18);
  }
  .goal-editor textarea::placeholder { color: #fbbf24; }
  .ed-task {
    border: 1px solid #e8eef6; border-radius: 11px;
    padding: 12px 13px 13px; background: #fbfdff;
    transition: border-color .15s, box-shadow .15s, background .15s;
  }
  .ed-task:hover {
    border-color: #bfdbfe;
    box-shadow: 0 4px 14px -8px rgba(37, 99, 235, .55);
  }
  .ed-task.flash { animation: taskFlash 1.5s ease; }
  @keyframes taskFlash {
    0%   { border-color: #3b82f6; box-shadow: 0 0 0 5px rgba(59, 130, 246, .18); background: #f0f7ff; }
    100% { border-color: #e8eef6; box-shadow: none; background: #fbfdff; }
  }
  .ed-task-head {
    display: flex; align-items: center; gap: 6px; margin-bottom: 8px;
  }
  .ed-task-idx {
    flex: 0 0 auto; width: 21px; height: 21px; border-radius: 7px;
    background: #e2e8f0; color: #475569; font-size: 11px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .ed-task-actions { flex: 0 0 auto; display: flex; gap: 3px; }
  .ic-btn {
    flex: 0 0 auto; width: 24px; height: 24px;
    border: 1px solid #d8e0ea; background: #fff; color: #64748b;
    border-radius: 7px; font-size: 12px; font-family: inherit; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0; transition: all .14s ease; line-height: 1;
  }
  .ic-btn:hover { background: #f1f5f9; border-color: #94a3b8; color: #334155; }
  .ic-btn:disabled { opacity: .3; cursor: not-allowed; }
  .ic-btn:disabled:hover { background: #fff; border-color: #d8e0ea; color: #64748b; }
  .ic-btn.danger:hover { background: #fef2f2; border-color: #fca5a5; color: #dc2626; }
  .ed-inp {
    width: 100%; font-family: inherit; font-size: 12.5px; color: #1e293b;
    padding: 6px 9px; border: 1px solid #cbd5e1; border-radius: 7px;
    background: #fff; transition: border-color .15s, box-shadow .15s;
  }
  .ed-inp:focus {
    outline: none; border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, .14);
  }
  .ed-inp.name {
    flex: 1 1 auto; min-width: 0; font-weight: 600; font-size: 13px;
  }
  textarea.ed-inp { resize: vertical; min-height: 46px; line-height: 1.5; }
  .ed-sub-label {
    display: flex; align-items: center; gap: 6px;
    margin: 8px 0 5px; font-size: 11.5px; color: #64748b; font-weight: 600;
  }
  .ed-sub-label i { font-style: normal; font-size: 11px; opacity: .7; }
  .ed-task-dates {
    display: flex; align-items: center; gap: 7px; margin-top: 9px;
  }
  .ed-task-dates input {
    flex: 1 1 0; min-width: 0; font-family: inherit; font-size: 12.5px;
    color: #1e293b; padding: 6px 8px; border: 1px solid #cbd5e1;
    border-radius: 7px; background: #fff;
  }
  .ed-task-dates input:focus {
    outline: none; border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, .14);
  }
  .ed-task-dates span { color: #94a3b8; font-size: 12px; }
  .ed-task-foot {
    display: flex; align-items: center; gap: 6px; margin-top: 9px;
    padding-top: 8px; border-top: 1px dashed #eef2f7;
  }
  .ed-task-foot label {
    flex: 0 0 auto; font-size: 11.5px; color: #64748b; font-weight: 600;
  }
  .ed-link-row {
    display: flex; align-items: center; gap: 6px; margin-top: 9px;
    padding-top: 8px; border-top: 1px dashed #eef2f7;
  }
  .ed-link-row label {
    flex: 0 0 auto; font-size: 11.5px; color: #64748b; font-weight: 600;
  }
  .ed-link-row input {
    flex: 1 1 auto; min-width: 0; font-family: inherit; font-size: 12.5px;
    color: #1d4ed8; padding: 6px 9px; border: 1px solid #cbd5e1;
    border-radius: 7px; background: #f8fbff;
    transition: border-color .15s, box-shadow .15s, background .15s;
  }
  .ed-link-row input:focus {
    outline: none; border-color: #3b82f6; background: #fff;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, .14);
  }
  .ed-link-row input::placeholder { color: #94a3b8; }
  .ed-link-open {
    flex: 0 0 auto; width: 28px; height: 28px;
    border: 1px solid #cbd5e1; background: #fff; color: #64748b;
    border-radius: 7px; font-size: 13px; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0; text-decoration: none; transition: all .14s ease; line-height: 1;
  }
  .ed-link-open:hover {
    background: #eff6ff; border-color: #3b82f6; color: #2563eb;
  }
  .ed-link-open.disabled {
    opacity: .35; cursor: not-allowed; pointer-events: none;
  }
  .ed-link-state {
    flex: 0 0 auto; font-size: 11px; font-weight: 600;
    padding: 2px 6px; border-radius: 5px; display: none;
  }
  .ed-link-state.ok { display: inline-block; background: #d1fae5; color: #047857; }
  .ed-link-state.warn { display: inline-block; background: #fee2e2; color: #b91c1c; }
  .add-task-wrap {
    margin-top: 14px; padding-top: 12px;
    border-top: 1px dashed #e2e8f0;
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  }
  .shift-row {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 10px; font-size: 13px; color: #475569;
  }
  .shift-row input[type="number"] {
    width: 96px; font-family: inherit; font-size: 13px;
    padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px;
    background: #f8fafc;
  }
  .shift-row input[type="number"]:focus {
    outline: none; border-color: #3b82f6; background: #fff;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, .14);
  }
  .card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 16px;
    box-shadow: 0 6px 22px -12px rgba(15, 23, 42, .18); overflow: hidden;
  }
  .gantt-scroll { overflow-x: auto; overflow-y: hidden; }
  .gantt {
    --label-w: 322px; --day-pct: 2%;
    display: flex; flex-direction: column;
    min-width: 1080px; font-size: 13px;
  }
  .label-col {
    width: var(--label-w); flex: 0 0 var(--label-w);
    padding: 8px 14px; border-right: 1px solid #e2e8f0;
  }
  .time-col { flex: 1 1 auto; position: relative; min-width: 0; }
  .gantt-head {
    display: flex; height: 58px; background: #f8fafc;
    border-bottom: 2px solid #e2e8f0;
  }
  .gantt-head .label-col {
    display: flex; align-items: center; font-weight: 600;
    font-size: 12.5px; color: #475569; letter-spacing: .5px;
  }
  .gantt-head .time-col { height: 58px; overflow: hidden; }
  .month-seg {
    position: absolute; top: 0; height: 28px;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; color: #475569;
    border-left: 1px solid #e2e8f0; background: #f1f5f9;
    white-space: nowrap; overflow: hidden;
  }
  .month-seg:first-child { border-left: none; }
  .tick {
    position: absolute; top: 28px; height: 30px;
    border-left: 1px dashed #cbd5e1;
  }
  .tick.no-line { border-left: none; }
  .tick span {
    position: absolute; top: 6px; left: 4px;
    font-size: 11px; color: #94a3b8;
    white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  .gantt-body { position: relative; }
  .gantt-row {
    display: flex; height: 64px;
    border-bottom: 1px solid #f1f5f9;
    transition: background .15s ease;
  }
  .gantt-row:last-child { border-bottom: none; }
  .gantt-row:hover { background: #fafcff; }
  .gantt-row .label-col {
    display: flex; flex-direction: column; justify-content: center; gap: 5px;
  }
  .task-top { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .task-name {
    flex: 1 1 auto; min-width: 0;
    font-size: 13px; font-weight: 600; color: #1e293b;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    display: block; text-decoration: none;
  }
  .task-name.empty { color: #cbd5e1; font-weight: 500; font-style: italic; }
  .task-name.link {
    color: #2563eb; cursor: pointer;
    border-bottom: 1px dashed rgba(37, 99, 235, .45);
    padding-bottom: 1px;
  }
  .task-name.link:hover {
    color: #1d4ed8; border-bottom-color: #1d4ed8; text-decoration: underline;
  }
  .task-name.link:visited { color: #7c3aed; }
  .task-name.link.empty {
    color: #93c5fd; font-style: italic; font-weight: 500;
  }
  .task-name.link::after {
    content: '↗'; font-size: 10px; margin-left: 3px;
    opacity: .7; font-weight: 400;
  }
  .task-sub {
    font-size: 11.5px; color: #94a3b8;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .badge {
    flex: 0 0 auto; font-size: 11px; font-weight: 600;
    padding: 2px 8px; border-radius: 999px;
    white-space: nowrap; letter-spacing: .3px;
  }
  .badge.done    { background: #d1fae5; color: #047857; }
  .badge.active  { background: #dbeafe; color: #1d4ed8; }
  .badge.pending { background: #e2e8f0; color: #64748b; }
  .gantt-row .time-col {
    background-image: repeating-linear-gradient(
      90deg, #eef2f7 0, #eef2f7 1px, transparent 1px, transparent var(--day-pct)
    );
  }
  .gantt.no-grid .gantt-row .time-col { background-image: none; }
  .bar {
    position: absolute; top: 50%; transform: translateY(-50%);
    height: 24px; border-radius: 6px; overflow: hidden;
    cursor: default; transition: filter .15s ease;
  }
  .bar:hover { filter: brightness(.95); }
  .bar.done {
    background: linear-gradient(180deg, #34d399 0%, #10b981 100%);
    box-shadow: 0 2px 6px -1px rgba(16, 185, 129, .55);
  }
  .bar.active {
    background: #dbeafe; border: 1px solid #93c5fd;
    animation: pulse 2.2s ease-in-out infinite;
  }
  .bar.pending { background: #e2e8f0; border: 1px solid #cbd5e1; }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, .45); }
    50%      { box-shadow: 0 0 0 5px rgba(59, 130, 246, 0); }
  }
  .bar-fill {
    height: 100%;
    background: linear-gradient(180deg, #60a5fa 0%, #3b82f6 100%);
    transition: width .4s ease;
  }
  .bar-check {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 12px; font-weight: 700;
  }
  .today-line {
    position: absolute; top: 0; bottom: 0; width: 2px;
    background: #ef4444; z-index: 8; pointer-events: none;
    box-shadow: 0 0 6px rgba(239, 68, 68, .5);
  }
  .today-line::after {
    content: '今天'; position: absolute; bottom: 4px; left: 50%;
    transform: translateX(-50%); background: #ef4444; color: #fff;
    font-size: 10px; line-height: 1; padding: 4px 6px;
    border-radius: 5px; white-space: nowrap; letter-spacing: .5px;
  }
  .legend {
    display: flex; flex-wrap: wrap; gap: 20px;
    padding: 13px 20px; border-top: 1px solid #f1f5f9;
    background: #fbfdff; font-size: 12px; color: #64748b;
  }
  .lg { display: flex; align-items: center; gap: 7px; }
  .sw { width: 22px; height: 11px; border-radius: 3px; display: inline-block; }
  .sw.done    { background: linear-gradient(180deg, #34d399, #10b981); }
  .sw.active  { background: #dbeafe; border: 1px solid #93c5fd; }
  .sw.pending { background: #e2e8f0; border: 1px solid #cbd5e1; }
  .sw.line    { width: 2px; height: 14px; background: #ef4444; border-radius: 1px; }
  .sw.link    { width: 22px; height: 11px; background: transparent; }
  .sw.link span {
    color: #2563eb; font-size: 12px; font-weight: 700;
    border-bottom: 1px dashed rgba(37,99,235,.45);
  }
  .footnote {
    margin-top: 14px; font-size: 12px; color: #94a3b8; text-align: right;
  }
  .modal-backdrop {
    position: fixed; inset: 0; background: rgba(15, 23, 42, .55);
    display: none; align-items: center; justify-content: center;
    z-index: 1000; padding: 20px;
    backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
  }
  .modal-backdrop.open { display: flex; animation: fadeIn .18s ease; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .modal {
    background: #fff; border-radius: 16px; width: 100%; max-width: 660px;
    box-shadow: 0 20px 60px -20px rgba(15, 23, 42, .55);
    animation: modalIn .22s ease; overflow: hidden;
  }
  @keyframes modalIn {
    from { opacity: 0; transform: translateY(10px) scale(.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .modal-head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; padding: 16px 20px; border-bottom: 1px solid #f1f5f9;
  }
  .modal-head h3 {
    margin: 0; font-size: 15px; color: #0f172a;
    display: flex; align-items: center; gap: 8px;
  }
  .modal-close {
    width: 28px; height: 28px; border: none; background: transparent;
    font-size: 20px; color: #94a3b8; cursor: pointer; border-radius: 7px;
    display: flex; align-items: center; justify-content: center;
    line-height: 1; padding: 0; font-family: inherit;
  }
  .modal-close:hover { background: #f1f5f9; color: #334155; }
  .modal-body { padding: 18px 20px; }
  .modal-desc {
    margin: 0 0 12px; font-size: 13px; color: #64748b; line-height: 1.65;
  }
  .modal-desc code {
    background: #f1f5f9; padding: 1px 5px; border-radius: 4px;
    font-size: 12px; color: #475569;
  }
  .modal-body textarea {
    width: 100%;
    font-family: ui-monospace, "SF Mono", Consolas, "Liberation Mono", monospace;
    font-size: 12px; line-height: 1.6; color: #0f172a;
    padding: 11px 12px; border: 1px solid #cbd5e1; border-radius: 9px;
    background: #f8fafc; resize: vertical; min-height: 108px;
    word-break: break-all; transition: border-color .15s, box-shadow .15s;
